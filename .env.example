# Copy to .env and fill in from YOUR Supabase project (Settings -> API).
# The publishable (anon) key is public by design; access is controlled by RLS.
# NEVER put the service_role key in this file or anywhere in client code.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXX
